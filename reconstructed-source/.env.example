# Local or isolated preview URL. Do not use the production hostname for smoke
# tests or reconstruction deployments.
NEXT_PUBLIC_SITE_URL=http://127.0.0.1:3000
SITE_URL=http://127.0.0.1:3000

# Authentication and one-time administrator setup
JWT_SECRET=
ADMIN_SETUP_KEY=

# Transactional email
RESEND_API_KEY=
FROM_EMAIL=UpDerma <orders@upderma.com>
REPLY_TO_EMAIL=support@upderma.com

# Optional WhatsApp integration
WHATSAPP_API_TOKEN=

# Preview-only smoke test. The script refuses the live upderma.com hostname and
# requires SMOKE_MUTATIONS_ACK=preview-only before creating synthetic records.
SMOKE_BASE_URL=http://127.0.0.1:3000
SMOKE_ADMIN_EMAIL=
SMOKE_ADMIN_PASSWORD=
SMOKE_MUTATIONS_ACK=
SMOKE_PRODUCT_ID=prod_hair_oil
SMOKE_PACKAGE_TYPE=single

# Drizzle Kit / Cloudflare management credentials
CLOUDFLARE_ACCOUNT_ID=
CLOUDFLARE_DATABASE_ID=4e019080-4d99-4830-b17a-386a6ce4f628
CLOUDFLARE_D1_TOKEN=
